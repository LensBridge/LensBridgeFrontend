# The Minbar backend (LensBridgeBackend).
VITE_API_BASE_URL=http://localhost:8080

# tCketManage runs its own console on its own subdomain. The sidebar links out
# to it; nothing in this app talks to it except the board-event ticket picker.
VITE_TCKET_CONSOLE_URL=https://tcket.minbar.ca

# Shown in the sidebar footer. Anything other than "production" reads as dev.
VITE_APP_ENVIRONMENT=development
